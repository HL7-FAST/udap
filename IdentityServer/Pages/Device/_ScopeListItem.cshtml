@using IdentityServer.Pages.Device
@model ScopeViewModel

<li class="list-group-item">
    <div class="form-check">
        <input class="form-check-input consent-scopecheck"
               type="checkbox"
               name="Input.ScopesConsented"
               id="scopes_@Model.Value"
               value="@Model.Value"
               checked="@Model.Checked"
               disabled="@Model.Required" />
        @if (Model.Required)
        {
            <input type="hidden"
                   name="Input.ScopesConsented"
                   value="@Model.Value" />
        }
        <label class="form-check-label" for="scopes_@Model.Value">
            <strong>@Model.DisplayName</strong>
            @if (Model.Emphasize)
            {
                <i class="fa-solid fa-triangle-exclamation text-warning ms-1" title="Important" aria-hidden="true"></i>
            }
            @if (Model.Required)
            {
                <span class="badge badge-secondary ms-2">required</span>
            }
        </label>
    </div>
    @if (Model.Description != null)
    {
        <div class="form-text ms-4">@Model.Description</div>
    }
</li>
