@page
@model IdentityServer.Pages.Device.Index
@{
}

@if (Model.Input.UserCode == null)
{
    @*We need to collect the user code*@
    <div class="page-device-code">
        <div class="text-center mb-4">
            <span class="page-icon" aria-hidden="true"><i class="fa-solid fa-mobile-screen"></i></span>
            <h1 class="h3 mb-1">Device Authorization</h1>
            <p class="text-body-secondary mb-0">Please enter the code displayed on your device</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-6">
                <partial name="_ValidationSummary" />

                <div class="card">
                    <div class="card-body">
                        <form asp-page="/Device/Index" method="get">
                            <div class="mb-4">
                                <div class="form-outline" data-mdb-input-init>
                                    <input class="form-control user-code-input" id="userCode" name="userCode" autocomplete="off" autocapitalize="characters" spellcheck="false" autofocus />
                                    <label class="form-label" for="userCode">User Code</label>
                                </div>
                            </div>

                            <div class="d-grid">
                                <button data-mdb-ripple-init class="btn btn-primary" name="button">
                                    <i class="fa-solid fa-check me-2" aria-hidden="true"></i>Submit Code
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    @*collect consent for the user code provided*@
    <div class="page-device-confirmation">
        <div class="text-center mb-4">
            @if (Model.View.ClientLogoUrl != null)
            {
                <img src="@Model.View.ClientLogoUrl" alt="@Model.View.ClientName" class="client-logo rounded mb-3">
            }
            <h1 class="h3 mb-1">@Model.View.ClientName</h1>
            <p class="text-body-secondary mb-0">is requesting your permission</p>
            <div class="alert alert-info mt-3" role="alert">
                <i class="fa-solid fa-mobile-screen me-2" aria-hidden="true"></i>
                Please confirm this matches your device code: <strong>@Model.Input.UserCode</strong>
            </div>
            <p class="text-body-secondary mb-0">Uncheck the permissions you do not wish to grant</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <partial name="_ValidationSummary" />
            </div>
        </div>

        <form asp-page="/Device/Index">
            <input asp-for="Input.UserCode" type="hidden" />
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    @if (Model.View.IdentityScopes.Any())
                    {
                        <div class="mb-4">
                            <div class="card">
                                <div class="card-header">
                                    <i class="fa-solid fa-user me-2" aria-hidden="true"></i>
                                    Personal Information
                                </div>
                                <ul class="list-group list-group-flush">
                                    @foreach (var scope in Model.View.IdentityScopes)
                                    {
                                        <partial name="_ScopeListItem" model="@scope" />
                                    }
                                </ul>
                            </div>
                        </div>
                    }

                    @if (Model.View.ApiScopes.Any())
                    {
                        <div class="mb-4">
                            <div class="card">
                                <div class="card-header">
                                    <i class="fa-solid fa-list-check me-2" aria-hidden="true"></i>
                                    Application Access
                                </div>
                                <ul class="list-group list-group-flush">
                                    @foreach (var scope in Model.View.ApiScopes)
                                    {
                                        <partial name="_ScopeListItem" model="scope" />
                                    }
                                </ul>
                            </div>
                        </div>
                    }

                    <div class="mb-4">
                        <div class="card">
                            <div class="card-header">
                                <i class="fa-solid fa-pen-to-square me-2" aria-hidden="true"></i>
                                Description
                            </div>
                            <div class="card-body">
                                <div class="form-outline" data-mdb-input-init>
                                    <input class="form-control" asp-for="Input.Description" autofocus>
                                    <label class="form-label" asp-for="Input.Description">Description or device name</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Model.View.AllowRememberConsent)
                    {
                        <div class="mb-4">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Input.RememberConsent" id="rememberConsentDevice">
                                <label class="form-check-label fw-semibold" for="rememberConsentDevice">
                                    Remember My Decision
                                </label>
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2 mb-4">
                        <button name="Input.button" value="yes" data-mdb-ripple-init class="btn btn-primary flex-fill" autofocus>
                            <i class="fa-solid fa-check me-2" aria-hidden="true"></i>Yes, Allow
                        </button>
                        <button name="Input.button" value="no" data-mdb-ripple-init class="btn btn-outline-secondary flex-fill">
                            <i class="fa-solid fa-xmark me-2" aria-hidden="true"></i>No, Do Not Allow
                        </button>
                    </div>

                    @if (Model.View.ClientUrl != null)
                    {
                        <div class="text-center">
                            <a data-mdb-ripple-init class="btn btn-link" href="@Model.View.ClientUrl" target="_blank">
                                <i class="fa-solid fa-circle-info me-2" aria-hidden="true"></i>
                                More about @Model.View.ClientName
                            </a>
                        </div>
                    }
                </div>
            </div>
        </form>
    </div>
}
