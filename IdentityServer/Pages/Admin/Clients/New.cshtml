@page
@model IdentityServer.Pages.Admin.Clients.NewModel
@{
}

@if (Model.Created)
{
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="alert alert-success" role="alert">
                <h4 class="alert-heading">
                    <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>
                    Client Created Successfully
                </h4>
                <hr>
                <p class="mb-2"><strong>Client ID:</strong> <code class="fs-6">@Model.InputModel.ClientId</code></p>
                <p class="mb-3">The client secret is displayed below. <strong class="text-danger">Copy it now, as it won't be shown again.</strong></p>

                <div class="card border-danger mb-3">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="fa-solid fa-key text-warning fs-4" aria-hidden="true"></i>
                        <code class="fs-5 flex-grow-1">@Model.InputModel.Secret</code>
                        <button data-mdb-ripple-init class="btn btn-outline-secondary btn-sm" data-copy="@Model.InputModel.Secret" aria-label="Copy client secret">
                            <i class="fa-solid fa-copy" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a asp-page="/Admin/Clients/Edit" asp-route-id="@Model.InputModel.ClientId" data-mdb-ripple-init class="btn btn-primary">
                        <i class="fa-solid fa-pen-to-square me-2" aria-hidden="true"></i>Configure Client
                    </a>
                    <a asp-page="/Admin/Clients/Index" data-mdb-ripple-init class="btn btn-outline-secondary">
                        <i class="fa-solid fa-list-check me-2" aria-hidden="true"></i>Back to Clients
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <partial name="_PageHeader" model='new PageHeader("fa-plus", "New Client")' />

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <partial name="_ValidationSummary" />

            <div class="card">
                <div class="card-header">
                    <i class="fa-solid fa-desktop me-2" aria-hidden="true"></i>
                    Client Details
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-4">
                            <div class="form-outline" data-mdb-input-init>
                                <input class="form-control" asp-for="@Model.InputModel.ClientId" autofocus />
                                <label class="form-label" asp-for="@Model.InputModel.ClientId">Client ID</label>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-outline" data-mdb-input-init>
                                <input class="form-control" asp-for="@Model.InputModel.Secret" />
                                <label class="form-label" asp-for="@Model.InputModel.Secret">Client Secret</label>
                            </div>
                            <div class="form-text">This will only be shown once after creation.</div>
                        </div>

                        <div class="mb-4">
                            <div class="form-outline" data-mdb-input-init>
                                <input class="form-control" asp-for="@Model.InputModel.Name" />
                                <label class="form-label" asp-for="@Model.InputModel.Name">Client Name</label>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="@Model.InputModel.Flow" class="form-label">Grant Type / Flow</label>
                            <select class="form-select" asp-for="@Model.InputModel.Flow">
                                <option value="0">Client Credentials</option>
                                <option value="1">Code Flow (with PKCE)</option>
                            </select>
                            <div class="form-text">Choose the OAuth 2.0 flow appropriate for your client type.</div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button data-mdb-ripple-init class="btn btn-primary" type="submit">
                                <i class="fa-solid fa-floppy-disk me-2" aria-hidden="true"></i>Create
                            </button>
                            <a data-mdb-ripple-init class="btn btn-outline-secondary" asp-page="/Admin/Clients/Index">
                                <i class="fa-solid fa-xmark me-2" aria-hidden="true"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
