@page
@model IdentityServer.Pages.Admin.Clients.IndexModel
@{
}

<partial name="_PageHeader" model='new PageHeader("fa-desktop", "Clients")' />

<div class="card mb-4">
    <div class="card-body">
        <form class="row g-3 align-items-center">
            <div class="col-md-6">
                <div class="form-outline" data-mdb-input-init>
                    <input class="form-control" id="filter" name="filter" type="search" value="@Model.Filter" autofocus />
                    <label class="form-label" for="filter">Filter by ID or name</label>
                </div>
            </div>
            <div class="col-md-6 d-flex gap-2">
                <button data-mdb-ripple-init class="btn btn-outline-primary">
                    <i class="fa-solid fa-magnifying-glass me-2" aria-hidden="true"></i>Search
                </button>
                <a asp-page="/Admin/Clients/New" data-mdb-ripple-init class="btn btn-primary ms-auto">
                    <i class="fa-solid fa-plus me-2" aria-hidden="true"></i>New Client
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Registered clients</caption>
            <thead>
                <tr>
                    <th scope="col">Client ID</th>
                    <th scope="col">Name</th>
                    <th scope="col">Flow</th>
                    <th scope="col" class="text-center">Scopes</th>
                </tr>
            </thead>

            <tbody>
                @foreach(var client in Model.Clients)
                {
                    <tr>
                        <td>
                            <a asp-page="/Admin/Clients/Edit" asp-route-id="@client.ClientId" class="fw-semibold">@client.ClientId</a>
                        </td>
                        <td>@client.Name</td>
                        <td>
                            <span class="badge badge-info rounded-pill">@client.Flow</span>
                        </td>
                        <td class="text-center">
                            <span class="badge badge-secondary rounded-pill">@client.AllowedScopesCount</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Clients.Any())
    {
        <partial name="_EmptyState" model="@("No clients match this filter.")" />
    }
</div>
