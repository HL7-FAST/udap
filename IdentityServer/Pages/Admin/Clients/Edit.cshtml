@page
@model IdentityServer.Pages.Admin.Clients.EditModel
@{
}

<partial name="_PageHeader" model='new PageHeader("fa-pen-to-square", "Edit Client", Model.InputModel.ClientId)' />

<div class="row justify-content-center">
    <div class="col-lg-8">
        <partial name="_ValidationSummary" />

        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-gear me-2" aria-hidden="true"></i>
                Client Configuration
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="@Model.InputModel.ClientId" />
                    <input type="hidden" asp-for="@Model.InputModel.Flow" />

                    <div class="mb-4">
                        <div class="form-outline" data-mdb-input-init>
                            <input class="form-control" asp-for="@Model.InputModel.Name" autofocus />
                            <label class="form-label" asp-for="@Model.InputModel.Name">Client Name</label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-outline" data-mdb-input-init>
                            <input class="form-control" asp-for="@Model.InputModel.AllowedScopes" />
                            <label class="form-label" asp-for="@Model.InputModel.AllowedScopes">Allowed Scopes</label>
                        </div>
                        <div class="form-text">Enter scopes separated by spaces.</div>
                    </div>

                    @if (Model.InputModel.Flow == IdentityServer.Pages.Admin.Clients.Flow.CodeFlowWithPkce)
                    {
                        <h2 class="h6 text-body-secondary text-uppercase mt-4 mb-3">Redirect URIs</h2>

                        <div class="mb-4">
                            <div class="form-outline" data-mdb-input-init>
                                <input class="form-control" asp-for="@Model.InputModel.RedirectUri" />
                                <label class="form-label" asp-for="@Model.InputModel.RedirectUri">Redirect URI</label>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-outline" data-mdb-input-init>
                                <input class="form-control" asp-for="@Model.InputModel.PostLogoutRedirectUri" />
                                <label class="form-label" asp-for="@Model.InputModel.PostLogoutRedirectUri">Post Logout Redirect URI</label>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-outline" data-mdb-input-init>
                                <input class="form-control" asp-for="@Model.InputModel.FrontChannelLogoutUri" />
                                <label class="form-label" asp-for="@Model.InputModel.FrontChannelLogoutUri">Front Channel Logout URI</label>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-outline" data-mdb-input-init>
                                <input class="form-control" asp-for="@Model.InputModel.BackChannelLogoutUri" />
                                <label class="form-label" asp-for="@Model.InputModel.BackChannelLogoutUri">Back Channel Logout URI</label>
                            </div>
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button data-mdb-ripple-init class="btn btn-primary" type="submit" name="Button" value="save">
                            <i class="fa-solid fa-floppy-disk me-2" aria-hidden="true"></i>Save
                        </button>
                        <a data-mdb-ripple-init class="btn btn-outline-secondary" asp-page="/Admin/Clients/Index">
                            <i class="fa-solid fa-xmark me-2" aria-hidden="true"></i>Cancel
                        </a>
                        <button data-mdb-ripple-init class="btn btn-outline-danger ms-auto" type="submit" name="Button" value="delete" data-confirm="Are you sure you want to delete this client?">
                            <i class="fa-solid fa-trash me-2" aria-hidden="true"></i>Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
