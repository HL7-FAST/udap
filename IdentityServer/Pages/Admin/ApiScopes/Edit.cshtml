@page
@model IdentityServer.Pages.Admin.ApiScopes.EditModel
@{
}

<partial name="_PageHeader" model='new PageHeader("fa-pen-to-square", "Edit API Scope", Model.InputModel.Name)' />

<div class="row justify-content-center">
    <div class="col-lg-8">
        <partial name="_ValidationSummary" />

        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-gear me-2" aria-hidden="true"></i>
                Scope Configuration
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="@Model.InputModel.Name" />

                    <div class="mb-4">
                        <div class="form-outline" data-mdb-input-init>
                            <input class="form-control" asp-for="@Model.InputModel.DisplayName" autofocus />
                            <label class="form-label" asp-for="@Model.InputModel.DisplayName">Display Name</label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-outline" data-mdb-input-init>
                            <input class="form-control" asp-for="@Model.InputModel.UserClaims" />
                            <label class="form-label" asp-for="@Model.InputModel.UserClaims">User Claims</label>
                        </div>
                        <div class="form-text">Enter claims separated by spaces.</div>
                    </div>

                    <h2 class="h6 text-body-secondary text-uppercase mt-4 mb-3">Scope Settings</h2>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="@Model.InputModel.Enabled" id="enabledSwitch" />
                            <label class="form-check-label fw-semibold" for="enabledSwitch">
                                Enabled
                            </label>
                        </div>
                        <div class="form-text ms-4">Allow clients to request this scope.</div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="@Model.InputModel.ShowInDiscoveryDocument" id="discoverySwitch" />
                            <label class="form-check-label fw-semibold" for="discoverySwitch">
                                Show in Discovery Document
                            </label>
                        </div>
                        <div class="form-text ms-4">Make this scope visible in the discovery endpoint.</div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button data-mdb-ripple-init class="btn btn-primary" type="submit" name="Button" value="save">
                            <i class="fa-solid fa-floppy-disk me-2" aria-hidden="true"></i>Save
                        </button>
                        <a data-mdb-ripple-init class="btn btn-outline-secondary" asp-page="/Admin/ApiScopes/Index">
                            <i class="fa-solid fa-xmark me-2" aria-hidden="true"></i>Cancel
                        </a>
                        <button data-mdb-ripple-init class="btn btn-outline-danger ms-auto" type="submit" name="Button" value="delete" data-confirm="Are you sure you want to delete this scope?">
                            <i class="fa-solid fa-trash me-2" aria-hidden="true"></i>Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
