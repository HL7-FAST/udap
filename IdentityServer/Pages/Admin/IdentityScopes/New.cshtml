@page
@model IdentityServer.Pages.Admin.IdentityScopes.NewModel
@{
}

<partial name="_PageHeader" model='new PageHeader("fa-plus", "New Identity Scope")' />

<div class="row justify-content-center">
    <div class="col-lg-8">
        <partial name="_ValidationSummary" />

        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-id-card me-2" aria-hidden="true"></i>
                Scope Details
            </div>
            <div class="card-body">
                <form method="post">
                    <div class="mb-4">
                        <div class="form-outline" data-mdb-input-init>
                            <input class="form-control" asp-for="@Model.InputModel.Name" autofocus />
                            <label class="form-label" asp-for="@Model.InputModel.Name">Scope Name</label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-outline" data-mdb-input-init>
                            <input class="form-control" asp-for="@Model.InputModel.DisplayName" />
                            <label class="form-label" asp-for="@Model.InputModel.DisplayName">Display Name</label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-outline" data-mdb-input-init>
                            <input class="form-control" asp-for="@Model.InputModel.UserClaims" />
                            <label class="form-label" asp-for="@Model.InputModel.UserClaims">User Claims</label>
                        </div>
                        <div class="form-text">Enter claims separated by spaces (e.g., name email profile picture).</div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button data-mdb-ripple-init class="btn btn-primary" type="submit">
                            <i class="fa-solid fa-floppy-disk me-2" aria-hidden="true"></i>Create
                        </button>
                        <a data-mdb-ripple-init class="btn btn-outline-secondary" asp-page="/Admin/IdentityScopes/Index">
                            <i class="fa-solid fa-xmark me-2" aria-hidden="true"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
