@page
@model IdentityServer.Pages.Admin.IdentityScopes.IndexModel
@{
}

<partial name="_PageHeader" model='new PageHeader("fa-id-card", "Identity Scopes")' />

<div class="card mb-4">
    <div class="card-body">
        <form class="row g-3 align-items-center">
            <div class="col-md-6">
                <div class="form-outline" data-mdb-input-init>
                    <input class="form-control" id="filter" name="filter" type="search" value="@Model.Filter" autofocus />
                    <label class="form-label" for="filter">Filter by name</label>
                </div>
            </div>
            <div class="col-md-6 d-flex gap-2">
                <button data-mdb-ripple-init class="btn btn-outline-primary">
                    <i class="fa-solid fa-magnifying-glass me-2" aria-hidden="true"></i>Search
                </button>
                <a asp-page="/Admin/IdentityScopes/New" data-mdb-ripple-init class="btn btn-primary ms-auto">
                    <i class="fa-solid fa-plus me-2" aria-hidden="true"></i>New Scope
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Identity scopes</caption>
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Display Name</th>
                </tr>
            </thead>

            <tbody>
                @foreach(var scope in Model.Scopes)
                {
                    <tr>
                        <td>
                            <a asp-page="/Admin/IdentityScopes/Edit" asp-route-id="@scope.Name" class="fw-semibold">@scope.Name</a>
                        </td>
                        <td>@scope.DisplayName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Scopes.Any())
    {
        <partial name="_EmptyState" model="@("No identity scopes match this filter.")" />
    }
</div>
