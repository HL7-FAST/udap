@page
@model IdentityServer.Pages.Admin.IndexModel
@{
}

<partial name="_PageHeader" model='new PageHeader("fa-gear", "Server Administration", "Manage server configuration and settings")' />

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-list-check me-2" aria-hidden="true"></i>
                Administrative Sections
            </div>
            <div class="list-group list-group-flush">
                <a data-mdb-ripple-init class="list-group-item list-group-item-action d-flex align-items-center gap-3" asp-page="/Admin/Clients/Index">
                    <i class="fa-solid fa-desktop text-primary fs-4" aria-hidden="true"></i>
                    <div>
                        <div class="fw-semibold">Clients</div>
                        <small class="text-body-secondary">Manage registered clients</small>
                    </div>
                    <i class="fa-solid fa-chevron-right ms-auto text-body-secondary" aria-hidden="true"></i>
                </a>
                <a data-mdb-ripple-init class="list-group-item list-group-item-action d-flex align-items-center gap-3" asp-page="/Admin/IdentityScopes/Index">
                    <i class="fa-solid fa-id-card text-primary fs-4" aria-hidden="true"></i>
                    <div>
                        <div class="fw-semibold">Identity Scopes</div>
                        <small class="text-body-secondary">Configure identity resource scopes</small>
                    </div>
                    <i class="fa-solid fa-chevron-right ms-auto text-body-secondary" aria-hidden="true"></i>
                </a>
                <a data-mdb-ripple-init class="list-group-item list-group-item-action d-flex align-items-center gap-3" asp-page="/Admin/ApiScopes/Index">
                    <i class="fa-solid fa-list-check text-primary fs-4" aria-hidden="true"></i>
                    <div>
                        <div class="fw-semibold">API Scopes</div>
                        <small class="text-body-secondary">Manage API access scopes</small>
                    </div>
                    <i class="fa-solid fa-chevron-right ms-auto text-body-secondary" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>
</div>
