@page
@model IdentityServer.Pages.Portal.Index

<partial name="_PageHeader" model='new PageHeader("fa-door-open", "Client Application Portal")' />

<p class="text-body-secondary">This portal contains links to client applications that are configured
    with an InitiateLoginUri, which enables
   <a href="https://openid.net/specs/openid-connect-core-1_0.html#ThirdPartyInitiatedLogin">third-party initiated login</a>.
</p>

@if (!Model.Clients.Any())
{
    <div class="alert alert-info" role="alert">
        <i class="fa-solid fa-circle-info me-2" aria-hidden="true"></i>You do not have any clients configured with an InitiateLoginUri.
    </div>
}
else
{
    <div class="card">
        <div class="list-group list-group-flush">
            @foreach (var client in Model.Clients)
            {
                <a href="@client.InitiateLoginUri" data-mdb-ripple-init class="list-group-item list-group-item-action">@client.LinkText</a>
            }
        </div>
    </div>
}
