@page
@model IdentityServer.Pages.ServerSideSessions.IndexModel

<partial name="_PageHeader" model='new PageHeader("fa-users-gear", "User Sessions")' />

@if (Model.UserSessions != null)
{
    <div class="card mb-4">
        <div class="card-body">
            <form class="row g-3 align-items-center">
                <div class="col-md-4">
                    <div class="form-outline" data-mdb-input-init>
                        <input type="search" class="form-control" asp-for="@Model.DisplayNameFilter" autofocus />
                        <label class="form-label" asp-for="@Model.DisplayNameFilter">Name</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-outline" data-mdb-input-init>
                        <input type="search" class="form-control" asp-for="@Model.SessionIdFilter" />
                        <label class="form-label" asp-for="@Model.SessionIdFilter">Session Id</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-outline" data-mdb-input-init>
                        <input type="search" class="form-control" asp-for="@Model.SubjectIdFilter" />
                        <label class="form-label" asp-for="@Model.SubjectIdFilter">Subject Id</label>
                    </div>
                </div>
                <div class="col-12">
                    <button type="submit" data-mdb-ripple-init class="btn btn-outline-primary"><i class="fa-solid fa-magnifying-glass me-2" aria-hidden="true"></i>Filter</button>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            @if (Model.UserSessions.HasPrevResults)
            {
                <a data-mdb-ripple-init class="btn btn-outline-secondary btn-sm" asp-page="/ServerSideSessions/Index"
                     asp-route-prev="true"
                     asp-route-token="@Model.UserSessions.ResultsToken"
                     asp-route-DisplayNameFilter="@Model.DisplayNameFilter"
                     asp-route-SubjectIdFilter="@Model.SubjectIdFilter"
                     asp-route-SessionIdFilter="@Model.SessionIdFilter"
                ><i class="fa-solid fa-chevron-left me-2" aria-hidden="true"></i>Prev</a>
            }
        </div>

        @if (Model.UserSessions.TotalCount.HasValue)
        {
            <div class="text-body-secondary small">
                @if (Model.UserSessions.CurrentPage.HasValue && Model.UserSessions.TotalPages.HasValue)
                {
                    <text>
                        Total Results: @Model.UserSessions.TotalCount,
                        Page @Model.UserSessions.CurrentPage of @Model.UserSessions.TotalPages
                    </text>
                }
                else
                {
                    <text>
                        Total Results: @Model.UserSessions.TotalCount
                    </text>
                }
            </div>
        }

        <div>
            @if (Model.UserSessions.HasNextResults)
            {
                <a data-mdb-ripple-init class="btn btn-outline-secondary btn-sm" asp-page="/ServerSideSessions/Index"
                     asp-route-token="@Model.UserSessions.ResultsToken"
                     asp-route-DisplayNameFilter="@Model.DisplayNameFilter"
                     asp-route-SubjectIdFilter="@Model.SubjectIdFilter"
                     asp-route-SessionIdFilter="@Model.SessionIdFilter"
                >Next<i class="fa-solid fa-chevron-right ms-2" aria-hidden="true"></i></a>
            }
        </div>
    </div>

    <div class="card">
        @if (Model.UserSessions.Results.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <caption class="visually-hidden">User sessions</caption>
                    <thead>
                        <tr>
                            <th scope="col">Subject Id</th>
                            <th scope="col">Session Id</th>
                            <th scope="col">Display Name</th>
                            <th scope="col">Created</th>
                            <th scope="col">Expires</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in Model.UserSessions.Results)
                        {
                            <tr>
                                <td><code class="small">@session.SubjectId</code></td>
                                <td><code class="small">@session.SessionId</code></td>
                                <td>@session.DisplayName</td>
                                <td>@session.Created</td>
                                <td>@session.Expires</td>
                                <td>
                                    <form method="post">
                                        <input type="hidden" name="SessionId" value="@session.SessionId" />
                                        <button type="submit" data-mdb-ripple-init class="btn btn-sm btn-outline-danger" data-confirm="Delete this session?"><i class="fa-solid fa-trash me-2" aria-hidden="true"></i>Delete</button>
                                    </form>
                                </td>
                            </tr>
                            <tr><td colspan="6" class="text-body-secondary small">
                                <strong>Clients:</strong>
                                @if (session.ClientIds?.Any() == true)
                                {
                                    @(session.ClientIds.Aggregate((x, y) => $"{x}, {y}"))
                                }
                                else
                                {
                                    @("None")
                                }
                            </td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <partial name="_EmptyState" model="@("No user sessions.")" />
        }
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>
        You do not have server-side sessions enabled.
        To do so, use <code>AddServerSideSessions</code> on your IdentityServer configuration.
        See the <a href="https://docs.duendesoftware.com/identityserver/ui/server-side-sessions">documentation</a> for more information.
    </div>
}
