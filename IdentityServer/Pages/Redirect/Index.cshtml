@page
@model IdentityServer.Pages.Redirect.IndexModel
@{
}

<div class="redirect-page row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fa-solid fa-spinner fa-spin fa-3x mb-3 text-primary" aria-hidden="true"></i>
                <h1 class="h3">Returning you to the application</h1>
                <p class="text-body-secondary">Once complete, you may close this tab.</p>
            </div>
        </div>
    </div>
</div>

<meta http-equiv="refresh" content="0;url=@Model.RedirectUri" data-url="@Model.RedirectUri">
<script src="~/js/signin-redirect.js"></script>
