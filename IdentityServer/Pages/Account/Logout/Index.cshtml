@page
@model IdentityServer.Pages.Logout.Index

<div class="logout-page row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fa-solid fa-right-from-bracket fa-3x mb-3 text-primary" aria-hidden="true"></i>
                <h1 class="h3">Sign out</h1>
                <p class="text-body-secondary">Are you sure you want to sign out?</p>

                <form asp-page="/Account/Logout/Index">
                    <input type="hidden" name="logoutId" value="@Model.LogoutId" />
                    <button data-mdb-ripple-init class="btn btn-primary"><i class="fa-solid fa-right-from-bracket me-2" aria-hidden="true"></i>Yes, sign out</button>
                </form>
            </div>
        </div>
    </div>
</div>
