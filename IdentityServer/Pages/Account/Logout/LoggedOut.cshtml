@page
@model IdentityServer.Pages.Logout.LoggedOut

<div class="logged-out-page row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fa-solid fa-circle-check fa-3x mb-3 text-success" aria-hidden="true"></i>
                <h1 class="h3">Signed out</h1>
                <p class="text-body-secondary">You are now signed out.</p>

                @if (Model.View.PostLogoutRedirectUri != null)
                {
                    <a class="PostLogoutRedirectUri btn btn-outline-primary" href="@Model.View.PostLogoutRedirectUri">Return to @Model.View.ClientName</a>
                }
            </div>
        </div>
    </div>

    @if (Model.View.SignOutIframeUrl != null)
    {
        <iframe width="0" height="0" class="signout" src="@Model.View.SignOutIframeUrl"></iframe>
    }
</div>

@section scripts
{
    @if (Model.View.AutomaticRedirectAfterSignOut)
    {
        <script src="~/js/signout-redirect.js"></script>
    }
}
