@page
@model IdentityServer.Pages.Create.Index

<div class="login-page">
    <partial name="_PageHeader" model='new PageHeader("fa-user-plus", "Create account")' />

    <partial name="_ValidationSummary" />

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <form asp-page="/Account/Create/Index">
                        <input type="hidden" asp-for="Input.ReturnUrl" />

                        <div class="mb-4">
                            <div class="form-outline" data-mdb-input-init>
                                <input class="form-control" asp-for="Input.Username" autocomplete="username" autofocus>
                                <label class="form-label" asp-for="Input.Username">Username</label>
                            </div>
                        </div>
                        <div class="mb-4">
                            <div class="form-outline" data-mdb-input-init>
                                <input type="password" class="form-control" asp-for="Input.Password" autocomplete="new-password">
                                <label class="form-label" asp-for="Input.Password">Password</label>
                            </div>
                        </div>
                        <div class="mb-4">
                            <div class="form-outline" data-mdb-input-init>
                                <input type="text" class="form-control" asp-for="Input.Name">
                                <label class="form-label" asp-for="Input.Name">Name</label>
                            </div>
                        </div>
                        <div class="mb-4">
                            <div class="form-outline" data-mdb-input-init>
                                <input type="email" class="form-control" asp-for="Input.Email" autocomplete="email">
                                <label class="form-label" asp-for="Input.Email">Email</label>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button data-mdb-ripple-init class="btn btn-primary" name="Input.Button" value="create">
                                <i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i>Create
                            </button>
                            <button data-mdb-ripple-init class="btn btn-outline-secondary" name="Input.Button" value="cancel">
                                <i class="fa-solid fa-xmark me-2" aria-hidden="true"></i>Cancel
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
