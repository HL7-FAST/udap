@page
@model IdentityServer.Pages.Login.Index

<div class="login-page">
    <div class="text-center mb-4">
        <span class="page-icon" aria-hidden="true"><i class="fa-solid fa-right-to-bracket"></i></span>
        <h1 class="h3 mb-1">Sign in</h1>
        <p class="text-body-secondary mb-0">Choose how to sign in</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <partial name="_ValidationSummary" />
        </div>
    </div>

    <div class="row justify-content-center">

        @if (Model.View.EnableLocalLogin)
        {
            <div class="col-lg-5 mb-4">
                <div class="card h-100">
                    <div class="card-header">
                        <i class="fa-solid fa-user me-2" aria-hidden="true"></i>
                        Local Account
                    </div>

                    <div class="card-body">
                        <form asp-page="/Account/Login/Index">
                            <input type="hidden" asp-for="Input.ReturnUrl" />

                            <div class="mb-4">
                                <div class="form-outline" data-mdb-input-init>
                                    <input class="form-control" asp-for="Input.Username" autocomplete="username" autofocus>
                                    <label class="form-label" asp-for="Input.Username">Username</label>
                                </div>
                            </div>
                            <div class="mb-4">
                                <div class="form-outline" data-mdb-input-init>
                                    <input type="password" class="form-control" asp-for="Input.Password" autocomplete="current-password">
                                    <label class="form-label" asp-for="Input.Password">Password</label>
                                </div>
                            </div>

                            @if (Model.View.AllowRememberLogin)
                            {
                                <div class="mb-4">
                                    <div class="form-check">
                                        <input class="form-check-input" asp-for="Input.RememberLogin" id="rememberLogin">
                                        <label class="form-check-label" for="rememberLogin">
                                            Remember My Login
                                        </label>
                                    </div>
                                </div>
                            }

                            <div class="d-grid gap-2">
                                <button data-mdb-ripple-init class="btn btn-primary" name="Input.Button" value="login">
                                    <i class="fa-solid fa-right-to-bracket me-2" aria-hidden="true"></i>Sign In
                                </button>
                                <button data-mdb-ripple-init class="btn btn-outline-secondary" name="Input.Button" value="cancel">
                                    <i class="fa-solid fa-xmark me-2" aria-hidden="true"></i>Cancel
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }

        <div class="col-lg-5 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <i class="fa-solid fa-circle-info me-2" aria-hidden="true"></i>
                    Test Credentials
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-body-secondary fw-normal">Username</dt>
                        <dd class="col-sm-8"><code>user</code></dd>
                        <dt class="col-sm-4 text-body-secondary fw-normal">Password</dt>
                        <dd class="col-sm-8 mb-0"><code>user</code></dd>
                    </dl>
                </div>
            </div>
        </div>

        @if (Model.View.TieredProvider != null)
        {
            <div class="col-lg-10 mb-4">
                <div class="card">
                    <div class="card-header">
                        <i class="fa-solid fa-layer-group me-2" aria-hidden="true"></i>
                        Tiered OAuth
                    </div>
                    <div class="card-body">
                        @{
                            var provider = Model.View.TieredProvider;
                        }
                        <a data-mdb-ripple-init class="btn btn-primary"
                           asp-page="/UdapTieredLogin/Challenge"
                           asp-route-scheme="@provider.AuthenticationScheme"
                           asp-route-returnUrl="@(provider.ReturnUrl)">
                            <i class="fa-solid fa-right-to-bracket me-2" aria-hidden="true"></i>
                            @provider.DisplayName
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (Model.View.VisibleExternalProviders.Any())
        {
            <div class="col-lg-10 mb-4">
                <div class="card">
                    <div class="card-header">
                        <i class="fa-solid fa-globe me-2" aria-hidden="true"></i>
                        External Account
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var provider in Model.View.VisibleExternalProviders)
                            {
                                <a data-mdb-ripple-init class="btn btn-outline-secondary"
                                   asp-page="/ExternalLogin/Challenge"
                                   asp-route-scheme="@provider.AuthenticationScheme"
                                   asp-route-returnUrl="@Model.Input.ReturnUrl">
                                    <i class="fa-solid fa-arrow-up-right-from-square me-2" aria-hidden="true"></i>
                                    @provider.DisplayName
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.View.EnableLocalLogin && !Model.View.VisibleExternalProviders.Any())
        {
            <div class="col-lg-10">
                <div class="alert alert-warning" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>
                    <strong>Invalid Login Request</strong>
                    <p class="mb-0">There are no login schemes configured for this request.</p>
                </div>
            </div>
        }
    </div>
</div>
