@page
@model IdentityServer.Pages.Udap.Communities.IndexModel
@{
}

<partial name="_PageHeader" model='new PageHeader("fa-users", "Communities")' />

<div class="card mb-4">
    <div class="card-body">
        <form class="row g-3 align-items-center">
            <div class="col-md-6">
                <div class="form-outline" data-mdb-input-init>
                    <input class="form-control" id="filter" name="filter" type="search" value="@Model.Filter" autofocus />
                    <label class="form-label" for="filter">Filter by name</label>
                </div>
            </div>
            <div class="col-md-6 d-flex gap-2">
                <button data-mdb-ripple-init class="btn btn-outline-primary">
                    <i class="fa-solid fa-magnifying-glass me-2" aria-hidden="true"></i>Search
                </button>
                <a asp-page="/Udap/Communities/New" data-mdb-ripple-init class="btn btn-primary ms-auto">
                    <i class="fa-solid fa-plus me-2" aria-hidden="true"></i>New Community
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Trust communities</caption>
            <thead>
                <tr>
                    <th scope="col">Community ID</th>
                    <th scope="col">Name</th>
                    <th scope="col" class="text-center">Enabled</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var community in Model.Communities)
                {
                    <tr>
                        <td>
                            <a asp-page="/Udap/Communities/Edit" asp-route-id="@community.CommunityId" class="fw-semibold">@community.CommunityId</a>
                        </td>
                        <td>@community.Name</td>
                        <td class="text-center">
                            @if (community.Enabled)
                            {
                                <span class="badge rounded-pill badge-success">
                                    <i class="fa-solid fa-check me-1" aria-hidden="true"></i>Enabled
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill badge-secondary">
                                    <i class="fa-solid fa-xmark me-1" aria-hidden="true"></i>Disabled
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Communities.Any())
    {
        <partial name="_EmptyState" model="@("No communities match this filter.")" />
    }
</div>
