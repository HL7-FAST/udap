@page
@model IdentityServer.Pages.Udap.Anchors.DeleteModel
@{
}

<partial name="_PageHeader" model='new PageHeader("fa-trash", "Delete Trust Anchor")' />

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="alert alert-warning" role="alert">
            <h5 class="alert-heading">
                <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>
                Confirm Deletion
            </h5>
            <p class="mb-0">Are you sure you want to delete this trust anchor? This action cannot be undone.</p>
        </div>

        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-circle-info me-2" aria-hidden="true"></i>
                Trust Anchor Details
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-body-secondary fw-normal">Anchor ID</dt>
                    <dd class="col-sm-8">
                        <code>@Model.InputModel.AnchorId</code>
                    </dd>

                    <dt class="col-sm-4 text-body-secondary fw-normal">Community</dt>
                    <dd class="col-sm-8">
                        @Model.InputModel.Community?.Name
                    </dd>

                    <dt class="col-sm-4 text-body-secondary fw-normal">Name</dt>
                    <dd class="col-sm-8">
                        @Model.InputModel.Name
                    </dd>

                    <dt class="col-sm-4 text-body-secondary fw-normal">Certificate</dt>
                    <dd class="col-sm-8">
                        <code class="small">@Model.InputModel.Certificate.Substring(0, Math.Min(150, Model.InputModel.Certificate.Length))...</code>
                    </dd>

                    <dt class="col-sm-4 text-body-secondary fw-normal">Thumbprint</dt>
                    <dd class="col-sm-8">
                        <code>@Model.InputModel.Thumbprint</code>
                    </dd>

                    <dt class="col-sm-4 text-body-secondary fw-normal">Valid From</dt>
                    <dd class="col-sm-8">
                        @Model.InputModel.BeginDate.ToString("yyyy-MM-dd HH:mm:ss")
                    </dd>

                    <dt class="col-sm-4 text-body-secondary fw-normal">Valid Until</dt>
                    <dd class="col-sm-8">
                        @Model.InputModel.EndDate.ToString("yyyy-MM-dd HH:mm:ss")
                    </dd>
                </dl>
            </div>
            <div class="card-footer">
                <form method="post">
                    <input type="hidden" asp-for="@Model.InputModel.AnchorId" />
                    <div class="d-flex flex-wrap gap-2">
                        <button data-mdb-ripple-init class="btn btn-danger" type="submit" name="Button" value="delete">
                            <i class="fa-solid fa-trash me-2" aria-hidden="true"></i>Confirm Delete
                        </button>
                        <a data-mdb-ripple-init class="btn btn-outline-secondary" asp-page="/Udap/Anchors/Index">
                            <i class="fa-solid fa-xmark me-2" aria-hidden="true"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
