@page
@model IdentityServer.Pages.Udap.Anchors.IndexModel
@{
}

<partial name="_PageHeader" model='new PageHeader("fa-certificate", "UDAP Trust Anchors")' />

<div class="row mb-4">
    <div class="col-lg-10">
        <div class="card">
            <div class="card-body">
                <form class="row g-3 align-items-center">
                    <div class="col-md-6">
                        <div class="form-outline" data-mdb-input-init>
                            <input class="form-control" id="filter" name="filter" type="search" value="@Model.Filter" autofocus />
                            <label class="form-label" for="filter">Filter by name or thumbprint</label>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex gap-2">
                        <button data-mdb-ripple-init class="btn btn-outline-primary">
                            <i class="fa-solid fa-magnifying-glass me-2" aria-hidden="true"></i>Search
                        </button>
                        <a asp-page="/Udap/Anchors/New" data-mdb-ripple-init class="btn btn-primary ms-auto">
                            <i class="fa-solid fa-plus me-2" aria-hidden="true"></i>New Anchor
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <caption class="visually-hidden">Trust anchors</caption>
                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Community</th>
                            <th scope="col">Name</th>
                            <th scope="col">Certificate</th>
                            <th scope="col">Thumbprint</th>
                            <th scope="col">Valid From</th>
                            <th scope="col">Valid Until</th>
                            <th scope="col" class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var anchor in Model.Anchors)
                        {
                            <tr>
                                <td>@anchor.AnchorId</td>
                                <td>
                                    <span class="badge badge-info">@anchor.Community.Name</span>
                                </td>
                                <td>@anchor.Name</td>
                                <td>
                                    <code class="small">@anchor.Certificate.Substring(0, Math.Min(50, anchor.Certificate.Length))...</code>
                                </td>
                                <td>
                                    <code class="small">@anchor.Thumbprint.Substring(0, Math.Min(20, anchor.Thumbprint.Length))...</code>
                                </td>
                                <td>@anchor.BeginDate.ToString("yyyy-MM-dd")</td>
                                <td>@anchor.EndDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-center">
                                    @if (anchor.Community.Name != "EmrDirect" && anchor.Community.Name != "FastCA")
                                    {
                                        <a asp-page="/Udap/Anchors/Delete" asp-route-id="@anchor.AnchorId" data-mdb-ripple-init class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-trash me-1" aria-hidden="true"></i>Delete
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">
                                            <i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Protected
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Anchors.Any())
            {
                <partial name="_EmptyState" model="@("No trust anchors match this filter.")" />
            }
        </div>
    </div>
</div>
