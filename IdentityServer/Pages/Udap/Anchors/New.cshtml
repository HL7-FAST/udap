@page
@model IdentityServer.Pages.Udap.Anchors.NewModel
@{
}

<partial name="_PageHeader" model='new PageHeader("fa-plus", "New Trust Anchor")' />

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-certificate me-2" aria-hidden="true"></i>
                Trust Anchor Details
            </div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <div class="mb-4">
                        <label asp-for="@Model.InputModel.CommunityId" class="form-label">Community</label>
                        <select class="form-select" asp-for="@Model.InputModel.CommunityId">
                            @foreach (var community in Model.Communities)
                            {
                                <option value="@community.CommunityId">@community.Name</option>
                            }
                        </select>
                        <div class="form-text">Select the community this anchor belongs to.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="@Model.AnchorFile" class="form-label">Certificate File</label>
                        <input class="form-control" asp-for="@Model.AnchorFile" type="file" accept=".pem, .crt, .cer, .key" />
                        <div class="form-text">Upload a PEM, CRT, CER, or KEY file.</div>

                        @if (!String.IsNullOrEmpty(Model.FileMessage))
                        {
                            <div class="alert alert-danger mt-3" role="alert">
                                <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>
                                @Model.FileMessage
                            </div>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button data-mdb-ripple-init class="btn btn-primary" type="submit">
                            <i class="fa-solid fa-upload me-2" aria-hidden="true"></i>Upload Anchor
                        </button>
                        <a data-mdb-ripple-init class="btn btn-outline-secondary" asp-page="/Udap/Anchors/Index">
                            <i class="fa-solid fa-xmark me-2" aria-hidden="true"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
