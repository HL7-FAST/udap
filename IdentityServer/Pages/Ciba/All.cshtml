@page
@model IdentityServer.Pages.Ciba.AllModel
@{
}

<partial name="_PageHeader" model='new PageHeader("fa-bell", "Pending Backchannel Login Requests")' />

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Pending backchannel login requests</caption>
            <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Client Id</th>
                    <th scope="col">Binding Message</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Logins?.Any() == true)
                {
                    @foreach (var login in Model.Logins)
                    {
                        <tr>
                            <td>@login.InternalId</td>
                            <td>@login.Client.ClientId</td>
                            <td>@login.BindingMessage</td>
                            <td>
                                <a asp-page="Consent" asp-route-id="@login.InternalId" data-mdb-ripple-init class="btn btn-sm btn-outline-primary">Process</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (Model.Logins?.Any() != true)
    {
        <partial name="_EmptyState" model="@("No pending login requests.")" />
    }
</div>
