@page
@model IdentityServer.Pages.Home.Index

<div class="welcome-page">
    <div class="text-center mb-5">
        <h1 class="display-6 fw-normal mb-2">
            FAST Security Reference Implementation Server
        </h1>
        <p class="lead text-body-secondary">
            A reference implementation of the <a href="https://build.fhir.org/ig/HL7/fhir-udap-security-ig/" target="_blank" rel="noopener">FAST Security Implementation Guide</a>
        </p>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <i class="fa-solid fa-globe me-2" aria-hidden="true"></i>
                    Well-Known Endpoints
                </div>
                <div class="list-group list-group-flush">
                    <a href="~/.well-known/openid-configuration" data-mdb-ripple-init class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                        <i class="fa-solid fa-link text-primary fs-4" aria-hidden="true"></i>
                        <div>
                            <div class="fw-semibold">OpenID Configuration</div>
                            <small class="text-body-secondary">.well-known/openid-configuration</small>
                        </div>
                        <i class="fa-solid fa-chevron-right ms-auto text-body-secondary" aria-hidden="true"></i>
                    </a>
                    <a href="~/.well-known/udap" data-mdb-ripple-init class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                        <i class="fa-solid fa-shield-halved text-primary fs-4" aria-hidden="true"></i>
                        <div>
                            <div class="fw-semibold">UDAP Configuration</div>
                            <small class="text-body-secondary">.well-known/udap</small>
                        </div>
                        <i class="fa-solid fa-chevron-right ms-auto text-body-secondary" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <i class="fa-solid fa-user-shield me-2" aria-hidden="true"></i>
                    Administration
                </div>
                <div class="list-group list-group-flush">
                    <a href="~/admin" data-mdb-ripple-init class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                        <i class="fa-solid fa-cog text-primary fs-4" aria-hidden="true"></i>
                        <div>
                            <div class="fw-semibold">System Admin</div>
                            <small class="text-body-secondary">Configure system settings</small>
                        </div>
                        <i class="fa-solid fa-chevron-right ms-auto text-body-secondary" aria-hidden="true"></i>
                    </a>
                    <a href="~/udap" data-mdb-ripple-init class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                        <i class="fa-solid fa-wrench text-primary fs-4" aria-hidden="true"></i>
                        <div>
                            <div class="fw-semibold">UDAP Admin</div>
                            <small class="text-body-secondary">Manage UDAP configuration</small>
                        </div>
                        <i class="fa-solid fa-chevron-right ms-auto text-body-secondary" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <i class="fa-solid fa-flask me-2" aria-hidden="true"></i>
                    Testing
                </div>
                <div class="list-group list-group-flush">
                    <a href="~/scenarios" data-mdb-ripple-init class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                        <i class="fa-solid fa-certificate text-primary fs-4" aria-hidden="true"></i>
                        <div>
                            <div class="fw-semibold">Certificate Test Scenarios</div>
                            <small class="text-body-secondary">Download good and deliberately bad client certificates</small>
                        </div>
                        <i class="fa-solid fa-chevron-right ms-auto text-body-secondary" aria-hidden="true"></i>
                    </a>
                    @if (Model.SandboxEnabled)
                    {
                        <a href="~/sandbox" data-mdb-ripple-init class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                            <i class="fa-solid fa-vial text-primary fs-4" aria-hidden="true"></i>
                            <div>
                                <div class="fw-semibold">Sandbox</div>
                                <small class="text-body-secondary">Register clients, run scenarios and query FHIR against this server</small>
                            </div>
                            <i class="fa-solid fa-chevron-right ms-auto text-body-secondary" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <p class="text-center text-body-secondary small mt-4">
        Built on <a href="https://duendesoftware.com/products/identityserver" target="_blank" rel="noopener">Duende IdentityServer <i class="fa-solid fa-arrow-up-right-from-square fa-sm" aria-hidden="true"></i></a> (version @Model.Version)
    </p>
</div>
